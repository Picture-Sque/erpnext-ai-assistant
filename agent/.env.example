# Agent service configuration
# TODO: commented out old static bearer token config
# AGENT_AUTH_TOKEN=your_static_bearer_token_here
JWT_SECRET=your_jwt_secret_shared_with_erpnext_here

# Dev Mock Authentication Fallback
# WARNING: Must be "false" in the production demo. Set to "true" only for local standalone testing without ERPNext.
ALLOW_DEV_MOCK_AUTH=false

# ERPNext REST API configuration
ERPNEXT_BASE_URL=http://localhost:8081
ERPNEXT_API_KEY=your_erpnext_api_key_here
ERPNEXT_API_SECRET=your_erpnext_api_secret_here

# LLM Provider Configuration (Groq - OpenAI Compatible)
GROQ_API_KEY=your_groq_api_key_here
