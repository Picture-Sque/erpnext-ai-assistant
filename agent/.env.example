# Agent service configuration
# TODO: commented out old static bearer token config
# AGENT_AUTH_TOKEN=your_static_bearer_token_here
JWT_SECRET=your_jwt_secret_shared_with_erpnext_here
# 32-byte url-safe base64 Fernet encryption key shared with ERPNext site_config.json
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENC_KEY=your_fernet_credential_encryption_key_here

# CORS Allowed Origins
# Comma-separated list of allowed web browser client origins (e.g. ERPNext Desk).
# Wildcard '*' is disallowed when allow_credentials=True. Unset allows no cross-origin requests
# (fail closed), except localhost origins when ALLOW_DEV_MOCK_AUTH is explicitly enabled.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Dev Mock Authentication Fallback
# WARNING: Must be "false" in the production demo. Set to "true" only for local standalone testing without ERPNext.
ALLOW_DEV_MOCK_AUTH=false

# Strict Identity Enforcement
# When true, requests without a valid user RequestContext will fail closed instead of falling back to service keys.
ERPNEXT_STRICT_IDENTITY=true

# Read-only Token Lifetime
READONLY_TOKEN_TTL_MINUTES=15

# ERPNext REST API configuration
ERPNEXT_BASE_URL=http://localhost:8081
ERPNEXT_API_KEY=your_erpnext_api_key_here
ERPNEXT_API_SECRET=your_erpnext_api_secret_here

# LLM Provider Configuration (Groq - OpenAI Compatible)
GROQ_API_KEY=your_groq_api_key_here
# Standard non-compound model for deterministic JSON extraction (defaults to openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Default ERPNext Company and Warehouse
# In single-company setups, DEFAULT_COMPANY resolves dynamically if left unset.
# In multi-company setups, DEFAULT_COMPANY must be set to the target company name.
# DEFAULT_WAREHOUSE must belong to the active company; otherwise it is ignored.
DEFAULT_COMPANY=your_default_company_here
DEFAULT_WAREHOUSE=your_default_warehouse_here

# Tool Execution Backend Configuration
# TOOL_BACKEND selects between direct Python REST calls and the ERPNext MCP server.
# Options:
#   direct - Invokes ERPNext operations directly via generic_tools (default rollback path)
#   mcp    - Routes eligible read operations through the ERPNext Model Context Protocol (MCP) server
TOOL_BACKEND=direct

# Optional MCP Configuration (defaults to stdio Python module invocation with 30s timeout)
# MCP_SERVER_COMMAND=python
# MCP_TIMEOUT=30

# Write controls (see docs/WRITE_ACCESS_PLAN.md)
# Emergency switch: true makes every assistant write fail with "Write operations are currently disabled."
# ERPNEXT_WRITES_DISABLED=false
# Most documents one confirmed bulk action may touch (default 25). Bulk delete is never available.
# WRITE_BULK_MAX=25
# Send the document's modified timestamp with update, submit and cancel so ERPNext refuses the write
# if someone else changed the document in between (default true).
# ERPNEXT_SEND_MODIFIED=true
# Audit log database (default agent/audit_log.db)
# SQLITE_AUDIT_DB_PATH=audit_log.db
# Ask ERPNext whether the signed-in user may perform a write before asking them to confirm it
# (default true). An unavailable or unclear answer never blocks; ERPNext still refuses on the write.
# ERPNEXT_PERMISSION_PREFLIGHT=true
